{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["unicorn", "oxc", "node", "promise"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "builtin": true,
    "node": true
  },
  "rules": {
    "no-undef": "error",
    "unicorn/no-new-array": "off"
  }
}
