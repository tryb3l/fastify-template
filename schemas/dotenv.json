{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schema:dotenv",
  "type": "object",
  "required": [
    "MONGO_URL",
    "JWT_SECRET",
    "COOKIE_SECRET",
    "FRONTEND_URL"
  ],
  "properties": {
    "NODE_ENV": {
      "type": "string",
      "default": "development"
    },
    "MONGO_URL": {
      "type": "string"
    },
    "PORT": {
      "type": "integer",
      "default": 3000
    },
    "LOG_LEVEL": {
      "type": "string",
      "default": "warn"
    },
    "JWT_SECRET": {
      "type": "string"
    },
    "JWT_EXPIRE_IN": {
      "type": "string",
      "default": "30m"
    },
    "JWT_REFRESH_EXPIRE_IN": {
      "type": "string",
      "default": "30d"
    },
    "COOKIE_SECRET": {
      "type": "string"
    },
    "COOKIE_ACCESS_MAX_AGE": {
      "type": "integer",
      "default": 3600
    },
    "COOKIE_REFRESH_MAX_AGE": {
      "type": "integer",
      "default": 2592000
    },
    "FRONTEND_URL": {
      "type": "string",
      "default": "http://localhost:5173"
    },
    "ADMIN_EMAIL": {
      "type": "string",
      "default": "admin@notes.local"
    },
    "ADMIN_PASSWORD": {
      "type": "string",
      "default": "changeme123"
    },
    "MAIL_FROM": {
      "type": "string"
    },
    "SMTP_HOST": {
      "type": "string"
    },
    "SMTP_PORT": {
      "type": "integer"
    },
    "SMTP_SECURE": {
      "type": "boolean",
      "default": false
    },
    "SMTP_USER": {
      "type": "string"
    },
    "SMTP_PASS": {
      "type": "string"
    }
  }
}