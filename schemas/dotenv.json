{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schema:dotenv",
  "type": "object",
  "required": [
    "MONGO_URL",
    "JWT_SECRET",
    "COOKIE_SECRET"
  ],
  "additionalProperties": false,
  "properties": {
    "NODE_ENV": {
      "type": "string",
      "default": "development"
    },
    "MONGO_URL": {
      "type": "string"
    },
    "PORT": {
      "type": "integer",
      "default": 3000
    },
    "LOG_LEVEL": {
      "type": "string",
      "default": "warn"
    },
    "JWT_SECRET": {
      "type": "string"
    },
    "JWT_EXPIRE_IN": {
      "type": "string",
      "default": "1h"
    },
    "JWT_REFRESH_EXPIRE_IN": {
      "type": "string",
      "default": "30d"
    },
    "COOKIE_SECRET": {
      "type": "string"
    },
    "COOKIE_ACCESS_MAX_AGE": {
      "type": "integer",
      "default": 3600
    },
    "COOKIE_REFRESH_MAX_AGE": {
      "type": "integer",
      "default": 2592000
    }
  }
}