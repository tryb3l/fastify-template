{
  "name": "fastify-boilerplate",
  "version": "1.0.0",
  "description": "Fastify boilerplate for my REST projects with MongoDB, Swagger, CORS and more",
  "main": "app.js",
  "engines": {
    "node": ">=26"
  },
  "directories": {
    "test": "test",
    "doc": "docs"
  },
  "scripts": {
    "start": "fastify start -l info --options app.js",
    "dev": "node scripts/dev.js",
    "dev:app": "fastify start --watch --pretty-logs --debug --options app.js",
    "dev:trace": "node scripts/dev.js --trace",
    "dev:trace:app": "node --trace-warnings node_modules/.bin/fastify start --options app.js",
    "test": "node test/run-tests.js",
    "test:ci": "node --test test/**/*.test.js",
    "test:makefile": "node --test test/makefile-bootstrap.test.js",
    "test:nostop": "node test/run-tests.js --nostop",
    "test:coverage": "node test/run-tests.js --coverage",
    "runtime:status": "node scripts/runtime-cli.js status",
    "runtime:cleanup": "node scripts/runtime-cli.js cleanup",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "migrate": "migrate-mongo up",
    "migrate:down": "migrate-mongo down",
    "migrate:status": "migrate-mongo status",
    "migrate:create": "migrate-mongo create"
  },
  "keywords": [
    "fastify",
    "fastify-cli",
    "fastify-boilerplate",
    "boilerplate",
    "mongodb",
    "rest",
    "api"
  ],
  "author": "Bohdan Trybel <bogdan.trybel@gmail.com> (https://github.com/tryb3l)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tryb3l/fastify-boilerplate.git"
  },
  "license": "ISC",
  "dependencies": {
    "@fastify/auth": "^5.1.0",
    "@fastify/autoload": "^6.5.0",
    "@fastify/caching": "^9.0.4",
    "@fastify/compress": "^9.2.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/csrf-protection": "^8.0.1",
    "@fastify/env": "^7.0.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/mongodb": "^10.0.1",
    "@fastify/multipart": "10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sensible": "^6.0.5",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "@fastify/under-pressure": "^9.1.0",
    "@fastify/websocket": "^11.3.0",
    "argon2": "^0.45.1",
    "close-with-grace": "^2.5.0",
    "csv-parse": "^7.0.2",
    "csv-stringify": "^6.8.3",
    "fastify": "5.12.3",
    "fastify-cli": "^8.0.1",
    "fastify-metrics": "^13.2.1",
    "fastify-plugin": "^6.0.0",
    "file-type": "^22.0.2",
    "migrate-mongo": "^14.0.7",
    "nodemailer": "^10.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dockerode": "^5.0.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "form-data": "^4.0.6",
    "globals": "^17.12.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6 "
  }
}