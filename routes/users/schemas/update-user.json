{
  "type": "object",
  "$id": "schema:user:update:body",
  "additionalProperties": false,
  "required": [
    "id"
  ],
  "properties": {
    "_id": {
      "type": "string",
      "format": "uuid",
      "readOnly": true
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "modifiedAt": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "username": {
      "type": "string",
      "minLength": 3,
      "maxLength": 32
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "firstName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "lastName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  }
}