{
  "$id": "schema:auth:authenticate",
  "type": "object",
  "required": [
    "username",
    "password"
  ],
  "properties": {
    "username": {
      "type": "string",
      "minLength": 3,
      "maxLength": 32
    },
    "password": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64
    }
  }
}