{
  "$id": "schema:auth:authenticate",
  "type": "object",
  "required": [
    "password"
  ],
  "anyOf": [
    {
      "required": [
        "username"
      ]
    },
    {
      "required": [
        "email"
      ]
    }
  ],
  "properties": {
    "username": {
      "type": "string",
      "minLength": 3,
      "maxLength": 255,
      "description": "The user's username (or email address if entered in this field)"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "The user's email address"
    },
    "password": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64
    }
  },
  "additionalProperties": false
}