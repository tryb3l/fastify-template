{
  "$id": "schema:auth:register",
  "type": "object",
  "required": [
    "username",
    "email",
    "password"
  ],
  "properties": {
    "username": {
      "type": "string",
      "minLength": 3,
      "maxLength": 32,
      "description": "Unique username"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Valid email address"
    },
    "password": {
      "$ref": "schema:auth:password-policy"
    }
  },
  "additionalProperties": false
}