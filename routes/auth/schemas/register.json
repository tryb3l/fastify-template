{
  "$id": "schema:auth:register",
  "type": "object",
  "properties": {
    "username": {
      "type": "string",
      "minLength": 3,
      "maxLength": 32
    },
    "password": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "admin"
      ]
    }
  },
  "required": [
    "username",
    "password",
    "email"
  ]
}