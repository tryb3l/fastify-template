{
  "$id": "schema:auth:register",
  "type": "object",
  "required": [
    "username",
    "email",
    "password"
  ],
  "properties": {
    "username": {
      "type": "string",
      "minLength": 3,
      "maxLength": 32,
      "description": "Unique username"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Valid email address"
    },
    "password": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64,
      "description": "Strong password"
    }
  },
  "additionalProperties": false
}